# Copy to .env and fill in. .env is not committed.

# Quack catalog
QUACK_TOKEN=
QUACK_HOST=localhost
QUACK_PORT=9494

# OVH Object Storage user keys. Use the endpoint shown on the bucket, without https://.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=gra
S3_ENDPOINT=s3.gra.io.cloud.ovh.net
S3_BUCKET=
S3_PREFIX=lake
S3_URL_STYLE=path

# Logs service. LOGS_* wins over the older WRITER_ID, INGEST_ADDR, and QUEUE_DIR names.
LOGS_WRITER_ID=logs
LOGS_ADDR=:8080
LOGS_QUEUE_DIR=./data/logs-queue

# Metrics service
METRICS_WRITER_ID=metrics
METRICS_ADDR=:8082
METRICS_QUEUE_DIR=./data/metrics-queue
QUEUE_MAX_BYTES=8589934592
FLUSH_BYTES=268435456
FLUSH_INTERVAL=10s

# Query
QUERY_ADDR=:8081
QUERY_TIMEOUT=10s
QUERY_MAX_ROWS=1000

# Maintenance
MAINTENANCE_INTERVAL=1h
DELETE_GRACE=15m

# Grafana. Infinity queries POST /query. Password is local only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Load generator. Started with: docker compose --profile load up --build loadgen
INGEST_URL=http://127.0.0.1:8080/v1/logs
LOAD_RATE=10000
LOAD_BATCH=1000
LOAD_WORKERS=4
